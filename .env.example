NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/daleel?schema=public
CORS_ORIGIN=http://localhost:5173
# Auth
JWT_SECRET=local-dev-only-access-secret-32-characters-minimum
JWT_REFRESH_SECRET=local-dev-only-refresh-secret-32-characters-minimum
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
BCRYPT_SALT_ROUNDS=12
PASSWORD_RESET_EXPIRES_IN=1200
PASSWORD_RESET_URL=http://localhost:3000/reset-password
# Cloudinary storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
STORAGE_IMAGE_MAX_BYTES=5242880
STORAGE_DOCUMENT_MAX_BYTES=15728640
# Mailing
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM="Daleel <no-reply@example.com>"

CORS_ORIGIN=http://localhost:5173

# Mentor recommendations. AI matching runs locally (no API key): the model
# (~35 MB) is downloaded from the Hugging Face Hub on first start and cached.
# Set to false to match on skills and experience only.
# EMBEDDINGS_ENABLED=true
# RECOMMENDATIONS_CACHE_TTL=3600