NODE_ENV=development
PORT=3000
JWT_SECRET=local-dev-only-access-secret-32-characters-minimum
JWT_REFRESH_SECRET=local-dev-only-refresh-secret-32-characters-minimum
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
BCRYPT_SALT_ROUNDS=12
DATABASE_URL=postgresql://user:password@localhost:5432/daleel?schema=public
