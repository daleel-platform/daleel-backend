NODE_ENV=test
PORT=3001
JWT_SECRET=test-only-access-secret-32-characters-minimum
JWT_REFRESH_SECRET=test-only-refresh-secret-32-characters-minimum
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
BCRYPT_SALT_ROUNDS=4
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/daleel-test?schema=public
PASSWORD_RESET_EXPIRES_IN=1200
PASSWORD_RESET_URL=http://localhost:3000/reset-password

# Set all three Cloudinary credentials to enable real uploads. Never commit secrets.
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
STORAGE_IMAGE_MAX_BYTES=5242880
STORAGE_DOCUMENT_MAX_BYTES=15728640
# Optional: Comma-separated allowed origins (defaults to true / reflection in test)
# CORS_ORIGIN=http://localhost:5173

# Mentor recommendations. Set HF_API_TOKEN (a Hugging Face access token) to add
# AI semantic matching; without it, matching uses skill overlap + experience only.
# HF_API_TOKEN=hf_your_token
# EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDINGS_TIMEOUT_MS=3000
# RECOMMENDATIONS_CACHE_TTL=3600
